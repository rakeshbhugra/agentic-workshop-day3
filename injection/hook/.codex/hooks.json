{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/block_danger.sh",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File .codex\\hooks\\block_danger.ps1",
            "timeout": 30,
            "statusMessage": "Checking command"
          }
        ]
      }
    ]
  }
}
